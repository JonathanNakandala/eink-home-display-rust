{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "always-update": true,
  "force-tag-creation": true,
  "pull-request-header": " ",
  "pull-request-footer": " ",
  "include-component-in-tag": true,
  "component-no-space": true,
  "pull-request-title-pattern": "chore(${component}): release ${version}",
  "packages": {
    ".": {
      "release-type": "rust",
      "package-name": "home-display-server",
      "bump-minor-pre-major": true,
      "draft": true,
      "prerelease": false,
      "exclude-paths": ["esphome"],
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance Improvements" },
        { "type": "revert", "section": "Reverts" },
        { "type": "build", "section": "Build and Dependencies" },
        { "type": "refactor", "section": "Code Refactoring" }
      ],
      "extra-files": [
        { "type": "json", "path": "config/openapi.json", "jsonpath": "$.info.version" },
        { "type": "json", "path": "config/admin-openapi.json", "jsonpath": "$.info.version" }
      ]
    },
    "esphome": {
      "release-type": "simple",
      "package-name": "home-display-firmware-esphome",
      "bump-minor-pre-major": true,
      "draft": true,
      "prerelease": false,
      "extra-files": ["/esphome/packages/version.yaml"]
    }
  }
}
