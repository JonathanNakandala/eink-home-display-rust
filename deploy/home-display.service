# Installed by install.sh (see INSTALL.md) as /etc/systemd/system/home-display.service. By hand:
#   systemctl daemon-reload && systemctl enable --now home-display
#
# Where things are:   /usr/local/bin/home-display-server   the program
#                     /etc/home-display/config.toml         the configuration, including the schedule (`[schedule]`)
#                     /var/lib/home-display/                everything the program writes: the certificate authority and the
#                                                           list of displays (back it up), the pictures, the cache
# To change something here, `systemctl edit home-display` (a drop-in that an upgrade leaves alone) and not this file.
[Unit]
Description=Home display: renders the dashboard and serves it to the display
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
# The schedule, the staleness checks and the restart cooldown all read the clock. A machine with no real-time clock (a
# Raspberry Pi) starts with the time it last saved, so starting before the clock is set would plan the first renders from the
# wrong time. time-sync.target is reached once a time service (systemd-timesyncd, or chrony with chrony-wait.service) has set
# it; with none enabled it is reached at once.
# Never give up: with a limit, systemd would leave the unit failed until someone ran `systemctl reset-failed`. The backoff
# below keeps a persistent failure to one start every 30 minutes, so there is no need for one.
StartLimitIntervalSec=0

[Service]
Type=simple
User=home-display
# StateDirectory makes /var/lib/home-display, owned by the user above and closed to everyone else, and lets the service write
# there whatever ProtectSystem says. Chrome keeps its own files under HOME.
StateDirectory=home-display
StateDirectoryMode=0700
WorkingDirectory=/var/lib/home-display
Environment=RUST_LOG=info
Environment=HOME=/var/lib/home-display
# What to refresh and when is in the configuration (`[schedule]`), and may be given more than once, each for its own hours and
# days. The log at start-up says in words what it means and how many refreshes each day gets (each is a wake of the display, so
# that number is what drains its battery). A --cron here would take the place of the file's, for one run.
#
# The certificate authority (`[server] transport` other than "http") is made only when asked: install.sh asks once, on a
# machine that has none. Do NOT put --init-pki in ExecStart. A missing authority later is a volume that was not mounted, and the
# refusal to start is what protects every display paired to the real one.
#
# --restart-cooldown (2 minutes unless given) is a second line of defence that holds under any supervisor: after a restart, no
# render starts until this long after the previous attempt, so a crash loop cannot hammer the services it reads.
ExecStart=/usr/local/bin/home-display-server --config-file /etc/home-display/config.toml
# Only a crash restarts it (a clean stop on SIGTERM exits 0). A render that fails is logged and retried at the next slot without
# ending the process. A process that is running but stuck is what home-display-health.timer is for.
Restart=on-failure
RestartSec=30s
# systemd 254 or newer: each consecutive restart waits longer, from 30s up to 30 minutes (about 30s, 1m, 2m, 3m, 6m, 10m, 17m,
# 30m, then 30m for as long as it keeps failing). A transient problem is therefore picked up again within 30 minutes of being
# fixed. Older systemd ignores these lines with a warning; with it, use a longer RestartSec instead.
RestartSteps=8
RestartMaxDelaySec=30min
TimeoutStopSec=20s
# Chrome's temporary profile and each render's page go in /tmp. Private to this service, they are removed whenever it stops,
# including after a crash or a kill, which would otherwise leave a Chrome profile (tens of MB) behind each time. So keep
# `server.directory` and `cache.directory` out of /tmp.
PrivateTmp=yes
# The whole service counts, Chrome included. While a render is running, Chrome with its helper processes measured about 1 GB
# on macOS (which counts shared pages, so Linux should be lower). Above MemoryHigh the kernel reclaims aggressively; at
# MemoryMax it kills the largest process, which is Chrome. OOMPolicy=continue keeps the service up when that happens (the
# default would stop all of it): that render fails, and the next one starts a fresh Chrome. Don't go below about 600M without
# measuring: after a day, `systemctl show home-display -p MemoryPeak` says what it really used, and twice that is a sound
# limit. On a host with little RAM, set both under what the host has.
MemoryHigh=1000M
MemoryMax=1300M
OOMPolicy=continue

# Sandboxing. The service holds the authority's keys and answers strangers on a port, so it is given only what it uses.
# Everything the program writes is under /var/lib/home-display (the configuration's `cache`, `file_store`, `server.directory`
# and `server.tls.directory`); if you point any of them elsewhere, add that path to ReadWritePaths in a drop-in or the service
# will fail to start with "Read-only file system".
#
# What is left out on purpose, because Chrome (which renders the page) needs it: MemoryDenyWriteExecute (its JavaScript engine
# compiles code), SystemCallFilter, RestrictNamespaces (its sandbox is made of namespaces) and ProcSubset. PrivateDevices is
# left out for the sake of the SPI and GPIO a locally attached panel uses; add it back if the panel is not attached to this
# machine. On Fedora and its relatives, SELinux may also need to be told about Chrome: INSTALL.md says how to tell.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
# The server listens on ports above 1024 and needs no capability. (Chrome's sandbox uses unprivileged user namespaces, which
# need none either.) If you set `[server] bind` to a port below 1024, give it CAP_NET_BIND_SERVICE instead.
CapabilityBoundingSet=
AmbientCapabilities=
# Unix sockets (the admin socket, Chrome), IPv4 and IPv6, and netlink to list the machine's addresses.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Files made by the service are private to its user: the authority's keys are made 0600 regardless, and the rest (displays,
# cache) is nobody else's business.
UMask=0077

[Install]
WantedBy=multi-user.target
