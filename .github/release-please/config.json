{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "always-update": true,
  "pull-request-header": " ",
  "pull-request-footer": " ",
  "include-component-in-tag": true,
  "component-no-space": true,
  "pull-request-title-pattern": "chore(${component}): release ${version}",
  "packages": {
    ".": {
      "release-type": "rust",
      "package-name": "eink-home-display-rust",
      "bump-minor-pre-major": true,
      "draft": false,
      "prerelease": false,
      "exclude-paths": ["esphome"]
    },
    "esphome": {
      "release-type": "simple",
      "package-name": "home-display-esphome-firmware",
      "bump-minor-pre-major": true,
      "draft": false,
      "prerelease": false,
      "extra-files": ["/esphome/packages/version.yaml"]
    }
  }
}
