# Settings for home-display-backup, which the daily timer runs. Installed as /etc/home-display/backup.env, root only, and kept
# as it is on an upgrade. Everything is optional: with none of it, a backup a day is kept here for two weeks.
# `sudo home-display-backup` reads this file too, so a backup by hand is made the same way.

# How many backups to keep here (the newest).
#BACKUP_KEEP=14

# Encrypt them. A backup holds the authority's root key and any API keys in plain text, so encrypt it if it leaves this machine
# or is kept anywhere that others can read. Make a key pair somewhere else (age-keygen -o key.txt; keep key.txt safe, and not
# on this machine), and put its public key (it starts age1) here: this machine can then make backups but cannot open them.
# Needs the age package. To open one: home-display-restore --identity key.txt FILE.age
#BACKUP_AGE_RECIPIENT="age1..."
# Or a file with one public key per line, to encrypt for several people.
#BACKUP_AGE_RECIPIENTS_FILE=/etc/home-display/backup-recipients.txt

# Also copy each one to another machine, with rsync: user@host:/folder/ (over ssh, with a key and no password), or a folder that
# is a mounted disk. Needs the rsync package, and a key that may log in there:
#   ssh-keygen -t ed25519 -f /root/.ssh/home-display-backup -N ''   then put its .pub on the other machine.
# Copies are added and never removed: the destination decides how long to keep them.
#BACKUP_DEST="backup@nas.example:/srv/backups/home-display/"
#BACKUP_SSH_KEY=/root/.ssh/home-display-backup
