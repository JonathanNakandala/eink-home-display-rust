{
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },
    "rust-analyzer.rustfmt.extraArgs": [],

    // The firmware's C++ (esphome/): formatted with the clang-format the Poetry environment pins, not the one the C/C++
    // extension bundles, which is another version and would format differently from `make -C esphome lint`. The style is
    // esphome/.clang-format.
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    "C_Cpp.clang_format_path": "${workspaceFolder}/.venv/bin/clang-format",
    "C_Cpp.clang_format_style": "file",
    "files.associations": {
        "**/esphome/**/*.h": "cpp"
    },
    "editor.rulers": [120],

    // The host tests against a real server (esphome/host/). CMake Tools uses the presets there (CMakePresets.json), so it needs
    // no kit: pick the "host" preset. The mbedTLS source is found in ESPHome's cache, so the firmware has to have been compiled
    // once (`make -C esphome compile`); the build goes to esphome/build/host, which is out of git. Nothing configures on open or
    // on an edit, since a fresh clone has nothing to configure from until that compile.
    "cmake.sourceDirectory": "${workspaceFolder}/esphome/host",
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": false,
    "cmake.configureOnEdit": false,
    "cmake.automaticReconfigure": false,
    "cmake.ctest.testExplorerIntegrationEnabled": true,
    // The Makefile is in esphome/, and its commands name files from there. Without this Makefile Tools runs make from the
    // repository root, finds "No rule to make target tests/main.cpp", and offers IntelliSense nothing.
    "makefile.makefilePath": "esphome/Makefile",
    "makefile.makeDirectory": "esphome",

    // The one Python file (esphome/scripts/) and the tools: the environment Poetry makes in .venv.
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    },

    // ESPHome's YAML has tags of its own, which the YAML extension would flag as errors.
    "yaml.customTags": [
        "!secret scalar",
        "!lambda scalar",
        "!include scalar",
        "!include mapping",
        "!extend scalar",
        "!remove scalar"
    ],

    // Not worth indexing or searching: build products and fetched toolchains.
    "files.watcherExclude": {
        "**/target/**": true,
        "**/.venv/**": true,
        "**/esphome/.esphome/**": true,
        "**/esphome/build/**": true
    },
    "search.exclude": {
        "**/target": true,
        "**/.venv": true,
        "**/esphome/.esphome": true,
        "**/esphome/build": true
    }
}
