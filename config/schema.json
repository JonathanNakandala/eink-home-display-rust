{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApplicationConfig",
  "type": "object",
  "properties": {
    "departures": {
      "description": "Departure boards shown on the display, in order. Each picks its own provider.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/DepartureBoardConfig"
      }
    },
    "display": {
      "$ref": "#/$defs/DisplayConfig"
    },
    "file_store": {
      "$ref": "#/$defs/FileStoreConfig"
    },
    "location": {
      "$ref": "#/$defs/LocationConfig"
    },
    "providers": {
      "description": "Credentials and endpoints shared by all boards using a provider.",
      "$ref": "#/$defs/ProvidersConfig",
      "default": {}
    },
    "weather": {
      "$ref": "#/$defs/WeatherConfig"
    }
  },
  "required": [
    "weather",
    "location",
    "file_store",
    "display"
  ],
  "$defs": {
    "DepartureBoardConfig": {
      "description": "One `[[departures]]` entry: a titled board fed by a single provider.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Set to false to skip this board without deleting it.",
          "type": "boolean",
          "default": true
        },
        "name": {
          "description": "Heading shown above the board on the display.",
          "type": "string"
        },
        "rows": {
          "description": "Maximum number of rows to show.",
          "type": "integer",
          "format": "uint8",
          "default": 4,
          "maximum": 255,
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "description": "National Rail live board between two CRS codes.",
          "type": "object",
          "properties": {
            "from": {
              "description": "CRS code of the station to show departures from, e.g. \"HRN\".",
              "type": "string"
            },
            "provider": {
              "type": "string",
              "const": "OpenLdbws"
            },
            "to": {
              "description": "CRS code the services must call at, e.g. \"WIH\".",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "from",
            "to"
          ]
        },
        {
          "description": "TfL arrivals at a single stop (bus stop or station NaPTAN id).",
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "Tfl"
            },
            "stop_id": {
              "description": "NaPTAN id from `tfl_stops`, e.g. \"940GZZLUTPN\" (tube) or \"490000173RC\" (bus).",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "stop_id"
          ]
        }
      ],
      "required": [
        "name"
      ]
    },
    "DisplayConfig": {
      "type": "object",
      "properties": {
        "dither": {
          "description": "How greys are reduced to the panel's levels.",
          "$ref": "#/$defs/Dither",
          "default": "None"
        },
        "kind": {
          "description": "Which display to render for and drive. Its size and colour depth are fixed by the hardware.",
          "$ref": "#/$defs/DisplayKind"
        }
      },
      "required": [
        "kind"
      ]
    },
    "DisplayKind": {
      "oneOf": [
        {
          "description": "Waveshare 7.5\" V2, 800x480 black and white.",
          "type": "string",
          "const": "WaveshareEpd7in5V2"
        },
        {
          "description": "Seeed reTerminal E1003, 10.3\" 1872x1404 with 16 greys. Rendering only for now.",
          "type": "string",
          "const": "ReTerminalE1003"
        }
      ]
    },
    "Dither": {
      "description": "How to reduce the rendered image to fewer levels.",
      "oneOf": [
        {
          "description": "Plain threshold: crisp text, harsh on greys.",
          "type": "string",
          "const": "None"
        },
        {
          "description": "Error diffusion: smooth greys, a bit noisy on text.",
          "type": "string",
          "const": "FloydSteinberg"
        },
        {
          "description": "4x4 Bayer matrix: regular pattern, stable between refreshes.",
          "type": "string",
          "const": "Ordered"
        }
      ]
    },
    "FileStoreConfig": {
      "type": "object",
      "properties": {
        "save_directory": {
          "description": "Where rendered images are saved; empty for the working directory.",
          "type": "string"
        }
      },
      "required": [
        "save_directory"
      ]
    },
    "LocationConfig": {
      "type": "object",
      "properties": {
        "latitude": {
          "description": "Decimal degrees, used for the weather lookup.",
          "type": "number",
          "format": "double"
        },
        "longitude": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ]
    },
    "OpenLdbwsConfig": {
      "type": "object",
      "properties": {
        "api_key": {
          "description": "Consumer Key from your raildata.org.uk \"Live Arrival and Departure Boards\" subscription.",
          "type": "string"
        },
        "host_url": {
          "description": "Base path up to and including the operation name; the CRS code is appended as the final path segment.",
          "type": "string"
        }
      },
      "required": [
        "api_key",
        "host_url"
      ]
    },
    "OpenWeatherConfig": {
      "type": "object",
      "properties": {
        "api_key": {
          "description": "32-character OpenWeather API key.",
          "type": "string",
          "maxLength": 32,
          "minLength": 32
        },
        "host_url": {
          "type": "string"
        }
      },
      "required": [
        "api_key",
        "host_url"
      ]
    },
    "ProvidersConfig": {
      "description": "Credentials/endpoints shared by every board using that provider, under `[providers.*]`.",
      "type": "object",
      "properties": {
        "open_ldbws": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpenLdbwsConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "tfl": {
          "anyOf": [
            {
              "$ref": "#/$defs/TflConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TflConfig": {
      "type": "object",
      "properties": {
        "app_key": {
          "description": "Optional: anonymous requests work but are rate limited.",
          "type": [
            "string",
            "null"
          ]
        },
        "host_url": {
          "description": "TfL Unified API base URL.",
          "type": "string",
          "default": "https://api.tfl.gov.uk"
        }
      }
    },
    "WeatherConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "description": "When false no weather is fetched and the display shows none.",
          "type": "boolean"
        },
        "open_weather": {
          "$ref": "#/$defs/OpenWeatherConfig"
        },
        "provider": {
          "$ref": "#/$defs/WeatherProvider"
        }
      },
      "required": [
        "enabled",
        "provider",
        "open_weather"
      ]
    },
    "WeatherProvider": {
      "type": "string",
      "enum": [
        "OpenWeather"
      ]
    }
  }
}
