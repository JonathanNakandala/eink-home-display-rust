# Install: copy to /etc/systemd/system/, adjust the paths and user, then
#   systemctl daemon-reload && systemctl enable --now eink-home-display
[Unit]
Description=E-ink home display: renders the dashboard and serves it to the display
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
# The schedule, the staleness checks and the restart cooldown all read the clock. A machine with no
# real-time clock (a Raspberry Pi) starts with the time it last saved, so starting before the clock is
# set would plan the first renders from the wrong time. time-sync.target is reached once a time service
# (systemd-timesyncd, or chrony with chrony-wait.service) has set it; with none enabled it is reached at once.
# Never give up: with a limit, systemd would leave the unit failed until someone ran
# `systemctl reset-failed`. The backoff below keeps a persistent failure to one start every
# 30 minutes, so there is no need for one.
StartLimitIntervalSec=0

[Service]
Type=simple
User=eink
WorkingDirectory=/opt/eink-home-display
Environment=RUST_LOG=info
# --cron can be given more than once; a refresh is due whenever any of them is, so each can cover its own
# hours and days. The log at start-up says in words what they mean and how many refreshes each day gets
# (each is a wake of the display, so that number is what drains its battery). For example, a minute-by-minute
# morning and lunchtime on weekdays, every 5 minutes the rest of the day, every 15 at night, hourly weekends:
#     --cron "* 7-8,11-12 * * 1-5" --cron "*/5 9-10,13-21 * * 1-5" \
#     --cron "*/15 22-23,0-6 * * 1-5" --cron "0 8-21 * * 6,0"
# --restart-cooldown is a second line of defence that holds under any supervisor: after a
# restart, no render starts until this long after the previous attempt.
ExecStart=/opt/eink-home-display/eink-home-display-rust \
    --config-file /opt/eink-home-display/config.toml \
    --cron "*/10 * * * *" \
    --restart-cooldown 2m
# Only a crash restarts it (a clean stop on SIGTERM exits 0). A render that fails is logged
# and retried at the next slot without ending the process.
Restart=on-failure
RestartSec=30s
# systemd 254 or newer: each consecutive restart waits longer, from 30s up to 30 minutes
# (about 30s, 1m, 2m, 3m, 6m, 10m, 17m, 30m, then 30m for as long as it keeps failing). A transient
# problem is therefore picked up again within 30 minutes of being fixed.
# Older systemd ignores these lines with a warning; with it, use a longer RestartSec instead.
RestartSteps=8
RestartMaxDelaySec=30min
TimeoutStopSec=20s
# Chrome's temporary profile and each render's page go in /tmp. Private to this service, they are
# removed whenever it stops, including after a crash or a kill, which would otherwise leave a Chrome
# profile (tens of MB) behind each time. So keep `server.directory` and `cache.directory` out of /tmp.
PrivateTmp=yes
# The whole service counts, Chrome included. While a render is running, Chrome with its helper
# processes measured about 1 GB on macOS (which counts shared pages, so Linux should be lower). Above
# MemoryHigh the kernel reclaims aggressively; at MemoryMax it kills the largest process, which is
# Chrome. OOMPolicy=continue keeps the service up when that happens (the default would stop all of it):
# that render fails, and the next one starts a fresh Chrome. Don't go below about 600M without
# measuring: after a day, `systemctl show eink-home-display -p MemoryPeak` says what it really used, and
# twice that is a sound limit. On a host with little RAM, set both under what the host has.
MemoryHigh=1000M
MemoryMax=1300M
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
